      "width": 140
    },
    {
      "id": "invoke",
      "lane": "gateway",
      "col": 1,
      "type": "backend",
      "label": "触发",
      "sublabel": "POST /gateway/callbacks/invoke",
      "width": 140
    },
    {
      "id": "scope",
      "lane": "gateway",
      "col": 2,
      "type": "security",
      "label": "校验 scope",
      "sublabel": "callbackScope",
      "tag": "权限",
      "width": 140
    },
    {
      "id": "subcache",
      "lane": "gateway",
      "col": 3,
      "type": "database",
      "label": "查订阅",
      "sublabel": "Redis 订阅方列表",
      "width": 140
    },
    {
      "id": "webhook",
      "lane": "gateway",
      "col": 4,
      "type": "messagebus",
      "label": "调用 WebHook",
      "sublabel": "channel_address",
      "width": 140
    },
    {
      "id": "consumer",
      "lane": "consumer",
      "col": 5,
      "type": "frontend",
      "label": "消费方系统",
      "sublabel": "订阅 WebHook 端点",
      "width": 140
    }
