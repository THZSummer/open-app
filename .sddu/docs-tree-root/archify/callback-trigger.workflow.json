  "edges": [
    {
      "id": "external-invoke",
      "from": "external",
      "to": "invoke",
      "label": "触发回调",
      "variant": "emphasis"
    },
    {
      "id": "invoke-scope",
      "from": "invoke",
      "to": "scope",
      "label": "校验"
    },
    {
      "id": "scope-subcache",
      "from": "scope",
      "to": "subcache",
      "label": "查订阅",
      "variant": "security"
    },
    {
      "id": "subcache-webhook",
      "from": "subcache",
      "to": "webhook",
      "label": "匹配",
      "variant": "default"
    },
    {
      "id": "webhook-consumer",
