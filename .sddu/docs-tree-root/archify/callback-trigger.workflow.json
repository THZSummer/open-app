  "cards": [
    {
      "dot": "cyan",
      "title": "触发链路",
      "items": [
        "外部系统经 POST /gateway/callbacks/invoke 触发",
        "先校验 callbackScope，再查 Redis 订阅方列表"
      ]
    },
    {
      "dot": "emerald",
      "title": "回调分发",
      "items": [
