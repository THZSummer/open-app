      "toCol": 2
    },
    {
      "id": "deliver",
      "label": "回调",
      "fromCol": 3,
      "toCol": 4,
      "variant": "emphasis"
    }
  ],
  "mainPath": [
    "external",
    "invoke",
    "scope",
    "subcache",
    "webhook",
    "consumer"
  ],
  "nodes": [
    {
      "id": "external",
      "lane": "external",
      "col": 0,
      "type": "external",
      "label": "外部系统",
